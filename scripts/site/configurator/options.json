      {
       "id": "circadian",
       "label": "Circadian",
       "effects": [
        {
         "do": "light",
         "scheme": {
          "kind": "cove",
          "circadian": true,
          "rect": 3.4,
          "fill": 0.36,
          "strip": 5,
          "glow": 0.44
         },
         "kelvin": "auto"
        }
       ],
       "sets": {
        "temperature": "auto"
       },
       "note": {
        "text": "Tunable white that follows the day and dims at night. The evidence is mixed: a pilot of 74 patients in redesigned rooms with dynamic lighting saw less delirium (46% against 76%), but it wasn't randomised and changed more than the lights. A randomised trial of 734 patients found bright dynamic light alone didn't reduce delirium.",
        "sources": [
         {
          "label": "Spies et al., Crit Care Med 2024",
          "url": "https://pubmed.ncbi.nlm.nih.gov/38112493/"
         },
         {
          "label": "Simons et al., Lancet Respir Med 2016",
          "url": "https://pubmed.ncbi.nlm.nih.gov/26895652/"
         }
        ],
        "clinical": true
       },
       "code": 4
      }

  {
   "id": "privacy",
   "label": "Privacy",
   "groups": [
    {
     "id": "front",
     "label": "Glazed front",
     "control": "choice",
     "default": "clear",
     "check": {
      "view": "entrance",
      "time": "afternoon"
     },
     "note": {
      "rooms": [
       "W1"
      ],
      "text": "This is an isolation room. Whichever option you choose, its door needs a seal along the bottom and testing against positive and negative pressure, so the room holds its pressure.",
      "sources": [
       {
        "label": "Stanley Access, ICU doors",
        "url": "https://stanleyaccess.com/node/2536"
       }
      ],
      "clinical": true
     },
     "options": [
      {
       "id": "clear",
       "label": "Clear with curtain",
       "effects": [
        {
         "do": "glass",
         "mode": "clear"
        },
        {
         "do": "visible",
         "part": "cfg_curtain",
         "on": true
        }
       ],
       "code": 0
      },
      {
       "id": "smart",
       "label": "Smart glass",
       "effects": [
        {
         "do": "glass",
         "mode": "smart"
        },
        {
         "do": "visible",
         "part": "cfg_curtain",
         "on": false
        }
       ],
       "note": {
        "text": "Switchable glass replaces the curtain: a wall switch takes it from clear to opaque, so staff can still see in when they need to. Memorial Sloan Kettering's ICU did this on its sliding doors, and the project report says removing fabric curtains improved infection control and made cleaning between patients easier. That's a design report, not a trial. CDC guidance counts curtain edges as high-touch surfaces.",
        "sources": [
         {
          "label": "Healthcare Design, Memorial Sloan Kettering ICU",
          "url": "https://healthcaredesignmagazine.com/news/memorial-sloan-kettering-cancer-center-intensive-care-unit-new-york-ny/1683/"
         },
         {
          "label": "Stanley Access, ICU doors",
          "url": "https://stanleyaccess.com/node/2536"
         },
         {
          "label": "ASSA ABLOY SL Hygienic ICU",
          "url": "https://assaabloyentrance.com/nz/en/documents/health/NZ-SL-Hygienic-ICU-BROCHURE.pdf"
         },
         {
          "label": "CDC environmental services",
          "url": "https://www.cdc.gov/infection-control/hcp/environmental-control/environmental-services.html"
         }
        ],
        "clinical": true
       },
       "code": 1
      },
      {
       "id": "blinds",
       "label": "Integral blinds",
       "effects": [
        {
         "do": "glass",
         "mode": "blinds"
